{
  "name": "daggerheart-sistema",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de fichas de Daggerheart — frontend estático no GitHub Pages + Supabase (Edge Functions, PostgreSQL e Storage)",
  "scripts": {
    "servir": "node tools/servidor-teste.mjs 8099",
    "teste": "node tools/testes-backend.mjs",
    "teste:e2e": "node tools/testes-e2e.mjs",
    "teste:layout-mobile": "node tools/testes-layout-mobile.mjs",
    "teste:layout-mestre-mobile": "node tools/testes-layout-mestre-mobile.mjs && node tools/testes-editor-adversario-mobile.mjs",
    "teste:layout-criacao-mobile": "node tools/testes-layout-criacao-mobile.mjs && node tools/testes-ajuda-criacao-mobile.mjs",
    "teste:layout-regras-mobile": "node tools/testes-layout-regras-mobile.mjs",
    "teste:layout-abertura-mobile": "node tools/testes-abertura-mobile.mjs",
    "teste:layout-ajustes-mobile": "node tools/testes-ajustes-mobile.mjs",
    "teste:layout-avanco-mobile": "node tools/testes-avanco-mobile.mjs",
    "teste:layout-descanso-mobile": "node tools/testes-descanso-mobile.mjs",
    "teste:layout-dano-mobile": "node tools/testes-dano-mobile.mjs",
    "teste:layout-mochila-em-uso-mobile": "node tools/testes-mochila-em-uso-mobile.mjs",
    "teste:layout-conjuracao-mobile": "node tools/testes-conjuracao-mobile.mjs",
    "teste:layout-toast-contexto-mobile": "node tools/testes-toast-contexto-mobile.mjs",
    "teste:layout-foto-mobile": "node tools/testes-foto-mobile.mjs",
    "teste:layout-responsivo": "node tools/testes-layout-responsivo.mjs",
    "teste:css": "node tools/conferir-css.mjs",
    "teste:tudo": "npm run teste:sintaxe && npm run teste:css && npm run teste && npm run teste:gerados && npm run teste:srd2 && npm run teste:e2e",
    "teste:sintaxe": "node tools/conferir-sintaxe.mjs",
    "teste:gerados": "node tools/conferir-gerados.mjs",
    "teste:auditoria": "python3 tools/auditar-pendencias-lote8.py",
    "teste:srd2-traducao": "node tools/conferir-srd2-traducao.mjs",
    "teste:srd2-cobertura": "node tools/conferir-srd2-cobertura.mjs",
    "gerar:srd2-inventario": "node tools/gerar-srd2-inventario.mjs",
    "teste:srd2-inventario": "node tools/conferir-srd2-inventario.mjs",
    "gerar:srd2-nucleo": "node tools/gerar-srd2-nucleo-auditoria.mjs",
    "teste:srd2-nucleo": "node tools/conferir-srd2-nucleo-auditoria.mjs",
    "teste:srd2-classes-novas": "node tools/conferir-srd2-classes-novas.mjs",
    "teste:srd2-subclasses-novas": "node tools/conferir-srd2-subclasses-novas.mjs",
    "teste:srd2-origens-novas": "node tools/conferir-srd2-origens-novas.mjs",
    "teste:srd2-transformacoes": "node tools/conferir-srd2-transformacoes.mjs",
    "teste:srd2-classes-core": "node tools/conferir-srd2-classes-core.mjs",
    "teste:srd2-origens-core": "node tools/conferir-srd2-origens-core.mjs",
    "teste:srd2-dominios-core": "node tools/conferir-srd2-dominios-core.mjs",
    "teste:srd2-cartas-core-arcana": "node tools/conferir-srd2-cartas-core-arcana.mjs",
    "teste:srd2": "npm run teste:srd2-traducao && npm run teste:srd2-cobertura && npm run teste:srd2-inventario && npm run teste:srd2-nucleo && npm run teste:srd2-classes-novas && npm run teste:srd2-subclasses-novas && npm run teste:srd2-origens-novas && npm run teste:srd2-transformacoes && npm run teste:srd2-classes-core && npm run teste:srd2-origens-core && npm run teste:srd2-dominios-core && npm run teste:srd2-cartas-core-arcana"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
