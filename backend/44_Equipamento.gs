  "cinco-estandartes-em-chamas": [{"id":"relacoes-politicas","nome":"Relações políticas","automacao":{"escopo":"mesa","fichaDeCampanha":{"escala":[{"valor":-3,"rotulo":"Inimigas"},{"valor":-2,"rotulo":"Adversas"},{"valor":-1,"rotulo":"Desfavoráveis"},{"valor":0,"rotulo":"Neutras"},{"valor":1,"rotulo":"Favoráveis"},{"valor":2,"rotulo":"Aliadas"},{"valor":3,"rotulo":"Aliadas próximas"}],"nacoes":[{"id":"armada","nome":"Armada","relacoes":{"gracien":2,"polaris":1,"voldaen":-1,"altomonte":-2},"recursos":["marinha vasta e poderosa","mapas superiores dos oceanos e dos ventos","monstros aquáticos como aliados"],"problemas":["acesso limitado por terra ao continente","pequena área terrestre","reputação como um povo de ladrões e piratas"],"objetivoPrincipal":"Construir uma infraestrutura portuária amigável em Polaris e Voldaen para fomentar o comércio.","objetivosSecundarios":["adquirir tecnologia aérea","enviar corsários contra os adversários"]},{"id":"altomonte","nome":"Altomonte","relacoes":{"voldaen":2,"armada":-2,"gracien":-2,"polaris":-3},"recursos":["exército fanático","fortuna oriunda de dízimos","influência e espionagem por meio de igrejas e templos","poder e autoridade divina","sacerdotes e serafins"],"problemas":["cercados de adversários","escassez de produção de comida local","insignificância marítima"],"objetivoPrincipal":"Redimir os canalhas de Armada para colocá-los no caminho certo.","objetivosSecundarios":["pedir aos deuses uma colheita farta","insinuar que Polaris apoia um culto aos Caídos"]},{"id":"gracien","nome":"Gracien","relacoes":{"armada":2,"polaris":1,"altomonte":-2,"voldaen":-3},"recursos":["força militar terrestre poderosa","grandes porções de terra cultivável","recursos naturais"],"problemas":["instabilidade política por ser uma nação nova","figuras remanescentes conservadoras e leais a Voldaen"],"objetivoPrincipal":"Vingar-se de Voldaen por séculos de injustiças.","objetivosSecundarios":["garantir parcerias comerciais duradouras com Armada e Pola