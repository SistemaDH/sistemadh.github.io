  "placa-mae": [{"id":"dano-tecnologico","nome":"Dano tecnológico","automacao":{"escopo":"ficha","rotuloDanoMagico":{"nome":"Tecnológico","abreviacao":"tec","nota":"Dano mágico chama-se tecnológico neste cenário; a regra é a mesma."}}},{"id":"ikonis","nome":"Ikonis e aprimoramentos","automacao":{"escopo":"ficha","danoAdicionalPorNivel":1,"nomeDoBonus":"Ligação","espacosDeAprimoramento":{"basePorPatamar1":2,"maisPorPatamarSeguinte":1}}},{"id":"quantum-e-sucata","nome":"Quantum e sucata","automacao":{"escopo":"ficha","exigeParaMovimentosDeDescanso":{"campo":"acessoARede","pergunta":"O grupo tem acesso à Rede (conector ou outra forma)?","recusa":"Sem acesso à Rede não dá para fazer movimentos de repouso neste cenário (livro p.301)."},"conversaoDeOuro":{"quantumPorPunhado":10,"quantumPorBolsa":100,"quantumPorCofre":1000,"quantumInicial":5,"quantumPorReliquia":20},"moeda":{"nome":"quantum","nomePlural":"quantum","abreviacao":"q","substituiOuro":true,"inicialNaCriacao":5,"nota":"1 quantum = 1 moeda na escada do ouro (10 por punhado), então a troca não perde nem cria valor."}}},{"id":"treinamento-ikonis","nome":"Treinamento Ikonis (troca a habilidade do guerreiro)","automacao":{"escopo":"ficha","substituiCaracteristicaDeClasse":{"classe":"guerreiro","remove":"Treinamento de Combate","poe":"Treinamento Ikonis","texto":"Você começa com o aprimoramento potência já desenvolvido e instalado na sua ikonis.","fonte":"Daggerheart: Esperança e Medo (Jambô), Capítulo 5, p. 295."}}}],
  "caca-a-monstros": [{"id":"a-cacada","nome":"A Caçada: cinco batidas","automacao":{"escopo":"mesa","trilhaDaCacada":{"fonte":"Daggerheart SRD 2.0, \"The Hunt\", p.202 — tradução nossa.","chave":"cacada:batida","podeDesviar":true,"batidas":[{"id":"chegada","ordem":1,"nome":"Chegada","texto":"O grupo é fisgado pela aventura por um evento estranho que sugere atividade do monstro."},{"id":"investigacao","ordem":2,"nome":"Investigação","texto":"O grupo segue pistas e junta indícios para descobrir a verdade sobre o monstro."},{"id":"escalada","ordem":3,"nome":"Escalada","texto":"O grupo reúne o que descobriu e monta um plano de ação para achá-lo e derrotá-lo."},{"id":"confronto","ordem":4,"nome":"Confronto","texto":"O grupo tenta banir, aprisionar ou destruir o monstro usando o que aprendeu antes."},{"id":"epilogo","ordem":5,"nome":"Epílogo","texto":"O grupo amarra as pontas soltas e segue para a próxima missão."}]}}},{"id":"pistas-liminares","nome":"Pistas Liminares","automacao":{"escopo":"mesa","pistasLiminares":{"fonte":"Daggerheart SRD 2.0, \"Liminal Clues\", p.202 — tradução nossa.","minimo":4,"maximo":6,"chaveDoTexto":"pista:","chaveDaRevelada":"pistaRevelada:"}}},{"id":"transformacoes-de-maldicao","nome":"As três transformações de maldição","automacao":{"escopo":"mesa","caracteristicasDeAdversario":{"fonte":"Daggerheart SRD 2.0, apêndice Caça a Monstros (\"Vampire’s Curse\" e \"Wolf’s Curse\", p.202) — tradução nossa.","nota":"Estas duas características são acrescentadas à ficha de um adversário importante — um vampiro ou um lobisomem de destaque. Copie o texto no editor de adversário da mesa.","itens":[{"id":"maldicao-do-vampiro","nome":"Maldição do Vampiro","tipo":"Ação","texto":"Maldição do Vampiro — Ação. Faça uma jogada de ataque contra um alvo em alcance Corpo a Corpo. Num sucesso, você pode gastar um Medo para este adversário cravar os dentes no pescoço do alvo e tentar transformá-lo num vampiro. Role uma quantidade de d8 igual ao patamar deste adversário e cause esse tanto de dano físico ao alvo. Depois role 1d6: se o resultado for igual ao de qualquer um dos dados de dano, o alvo marca TODO o Estresse dele e ganha a transformação Vampiro.","seOJogadorQuiser":"Se o jogador QUISER que o personagem vire vampiro, a jogada de ataque acerta automaticamente: o personagem sofre o dano, marca todo o Estresse e ganha a transformação.","contagem":null},{"id":"maldicao-do-lobo","nome":"Maldição do Lobo","tipo":"Ação","texto":"Maldição do Lobo — Ação. Faça uma jogada de ataque contra um alvo em alcance Corpo a Corpo. Num sucesso, você pode gastar um Medo para este adversário morder o alvo com ferocidade. Role uma quantidade de d20 igual ao patamar deste adversário e cause esse tanto de dano físico ao alvo. Se o alvo sofrer dano Maior ou mais por este ataque, ative uma Contagem de Licantropia (6) de longo prazo. Ela anda a cada descanso em que o personagem NÃO usar um movimento de descanso para conter o avanço da licantropia. Quando ela chega ao fim, o personagem ganha a transformação Lobisomem.","seOJogadorQuiser":"Se o jogador QUISER que o personagem vire lobisomem, a jogada de ataque acerta automaticamente: o personagem sofre o dano e a contagem é ativada independentemente de quantos PV ele marcou.","contagem":{"nome":"Contagem de Licantropia","tipo":"longo-prazo","valorInicial":6,"descricao":"Anda a cada descanso em que o personagem NÃO usar um movimento de descanso para conter o avanço da licantropia. No fim, ele ganha a transformação Lobisomem."}}]}}}],
  "castle-high": [{"id":"as-quatro-torres","nome":"As quatro torres","automacao":{"escopo":"mesa","escolhaDaMesa":{"fonte":"Daggerheart: Hope & Fear, \"Castle High Towers\", p.122 — tradução nossa.","chave":"torre:escolhida","rotulo":"Torre do grupo","ajuda":"Toque na torre que a mesa escolheu. Tocar na marcada desmarca.","opcoes":[{"id":"zenith","nome":"Zenith","nomeLivro":"Zenith","texto":"A torre mais alta do castelo, sob a decana Parsons (ela/dela), uma excêntrica animada com lápis presos no cabelo e nenhuma paciência para papelada. Ela ama ensinar mas não gosta de sala de aula: prefere passar trabalhos que tirem os estudantes da escola e os metam em situação maior do que eles.","escolhaSe":"Escolham Zenith se quiserem uma campanha de missões, em que os trabalhos da escola muitas vezes exigem explorar outras ilhas celestes.","perguntas":["Essas missões estranhas fazem parte de algum propósito maior? O que Parsons quer dizer quando fala que vocês \"foram escolhidos por um motivo\"?"],"gancho":"Se a mesa escolher Zenith, pense em como alguém ou algo nas ilhas celestes ao redor tem papel de destaque no mistério das crianças desaparecidas."},{"id":"star","nome":"Star","nomeLivro":"Star","texto":"A torre de estibordo (ou simplesmente Star) está sob o decano \"Coach\" Hallister (ele/dele), um professor de educação física rude e quase tão intenso quanto a loção pós-barba dele. Coach organiza cada ano letivo como um torneio de várias provas, com uniforme, prêmios e a nota de cada equipe num placar gigante.","escolhaSe":"Escolham Star se quiserem uma campanha estruturada, sobre azarões competitivos, rivalidade entre torres e aprender a trabalhar em equipe.","perguntas":["Por que Coach é tão duro com vocês? Ele vê potencial ou acha que vocês são perdedores — ou o torneio está armado?"],"gancho":"Se a mesa escolher Star, pense em como uma competição ou um torneio da escola tem papel de destaque no mistério das crianças desaparecidas."},{"id":"bower","nome":"Bower","nomeLivro":"Bower","texto":"A Torre do Arco (que os estudantes chamam de Bower) está nominalmente sob o decano Lin (elu/delu), famoso por ser tranquilo, cronicamente ausente e quase sempre tirando um cochilo. A maioria usa essa liberdade para enrolar e ir a festas; alguns usam para tocar os próprios objetivos de aventura sem ninguém no caminho.","escolhaSe":"Escolham Bower se quiserem uma campanha mais movida pelos jogadores, sobre jovens aventureiros independentes e oportunistas.","perguntas":["Lin é mesmo tão desinteressado quanto parece? Por que está sempre cansado? As dores de cabeça são disfarce de outra coisa?"],"gancho":"Se a mesa escolher Bower, pense em como as falhas dos adultos de Castle High têm papel de destaque no mistério das crianças desaparecidas."},{"id":"stern","nome":"Stern","nomeLivro":"Stern","texto":"A Torre Stern está sob o decano Lesher (ele/dele), um professor severo, de método antiquado e tolerância zero para bobagem. As janelas têm grade e o toque de recolher é cedo. Entra delinquente e sai aluno de honra, refeito por exercício, disciplina e decoreba. Claro que alguns estudantes simplesmente se recusam a ser ensinados.","escolhaSe":"Escolham Stern se quiserem uma campanha mais movida pelos jogadores, sobre estudantes rebeldes que fogem à noite, se metem em confusão e aprendem coisas que não deviam.","perguntas":["O que Lesher esconde? Um plano para tomar a escola? Um santuário do Senhor Demônio? Um lado sensível e boas intenções?"],"gancho":"Se a mesa escolher Stern, pense em como os temas de liberdade e controle têm papel de destaque no mistério das crianças desaparecidas."},{"id":"lock","nome":"Lock","nomeLivro":"Lock","texto":"A torre de bombordo está selada. Todo mundo a chama de Lock, e os estudantes cochicham sobre o que há dentro, como entrar e por que uma única janela se acende toda meia-noite. ⚠ Lock não é uma torre jogável: o livro a oferece como gancho de aventura ou como espaço para a mesa criar a torre dela.","escolhaSe":"O livro não oferece Lock como escolha do grupo — ela é gancho, ou a torre que vocês mesmos vão inventar.","perguntas":["O que se acende naquela janela toda meia-noite?"],"gancho":"Lock serve como gancho de aventura ou como o espaço em branco para a mesa inventar a própria torre.","naoJogavel":true}]}}},{"id":"artefato-de-fragmento-celeste","nome":"Artefato de fragmento celeste","automacao":{"escopo":"criacao","perguntasDeHistoria":{"fonte":"Daggerheart: Hope & Fear (Darrington Press), Capítulo 4: Castle High — tradução nossa: não existe edição da Jambô deste capítulo.","titulo":"O que esta campanha pergunta","nota":"Todo estudante de Castle High tem um artefato de fragmento celeste. Responda aqui e fica guardado na ficha, junto com o histórico — ou deixe em branco e resolva na mesa.","perguntas":[{"id":"artefato","pergunta":"Qual é o seu artefato de fragmento celeste?","nossa":true,"inspiracao":["uma vassoura (o mais comum)","um aspirador, tapete ou outro objeto doméstico","um medalhão, colar, berloque ou outra lembrança","uma bengala, órtese, cadeira de rodas ou outro apoio de mobilidade","uma capa fina"]},{"id":"como-conseguiu","pergunta":"Como você conseguiu o seu? Foi herdado, encontrado, fabricado, cultivado, ou outra coisa?","nossa":false,"inspiracao":[]},{"id":"como-e","pergunta":"E como ele é? Antigo, coberto de adesivos, sempre zumbindo, ou outra coisa?","nossa":false,"inspiracao":[]}]}}},{"id":"riley-averill","nome":"Riley Averill","automacao":{"escopo":"mesa","tabelaRolada":{"fonte":"Daggerheart: Hope & Fear, \"Riley Averill\", p.123 — tradução nossa.","dado":"d20","rotulo":"Perguntas para construir Riley","linhas":[{"n":1,"texto":"Como Riley era? Como gostava de se vestir?"},{"n":2,"texto":"Qual interesse ou hobby diferente uniu você e Riley?"},{"n":3,"texto":"De onde Riley dizia que vinha? O que a família dela achava de Castle High?"},{"n":4,"texto":"Riley queria vir para Castle High? Por que, ou por que não?"},{"n":5,"texto":"Que apelido você deu a Riley?"},{"n":6,"texto":"Como Riley decorou a parte dela do dormitório?"},{"n":7,"texto":"Que domínios Riley planejava estudar?"},{"n":8,"texto":"Com que atividades extracurriculares Riley estava animada?"},{"n":9,"texto":"O que Riley fez na semana de recepção que te fez rir?"},{"n":10,"texto":"Que segredo Riley te contou?"},{"n":11,"texto":"Com o que dava para ver que Riley era insegura?"},{"n":12,"texto":"Que habilidade surpreendente Riley tinha?"},{"n":13,"texto":"O que você notava Riley desenhando sempre nos papéis dela?"},{"n":14,"texto":"Que segredo Riley descobriu na sua torre?"},{"n":15,"texto":"O que Riley dizia que queria ser quando crescesse?"},{"n":16,"texto":"Qual era a sala preferida de Riley na escola? Por quê?"},{"n":17,"texto":"Riley se desentendeu com outro estudante durante a recepção. Quem era, o que causou a briga e como ela terminou?"},{"n":18,"texto":"Riley se dava bem com um dos veteranos que ajudavam os novatos na recepção. Qual era o nome dele, e por que os dois se aproximaram?"},{"n":19,"texto":"Um dos professores ameaçou Riley com detenção durante a recepção. Qual professor? Do que ele a acusou? Ela tinha feito aquilo?"},{"n":20,"texto":"Na segunda noite da recepção, você encontrou Riley chorando no meio da noite. O que ela te confidenciou?"}]}}}],
  "reino-do-weredragao": [{"id":"revelacoes-da-astromante","nome":"As Revelações da Astromante","automacao":{"escopo":"mesa","leituraDoCeuNoturno":{"fonte":"Daggerheart: Hope & Fear, Capítulo 4, p. 140–141. ⚠ Tradução nossa; os nomes próprios de lugar ficam como no original, porque não há edição em português para citar.","dados":"5d6","umDadoPorColuna":true,"colunas":[{"id":"lugarDoSegredo","ordem":1,"nome":"Lugar do Segredo","efeito":"Onde o grupo precisa ir para aprender um segredo que ajude a derrotar Forlorne. Cada jogador escreve, em sigilo, um segredo que ela esconde; entre sessões o Mestre escolhe um deles para inspirar a aventura."},{"id":"aliadoPoderoso","ordem":2,"nome":"Aliado Poderoso","efeito":"Um aliado que pode ajudar. Ele tem uma reserva de 3 de Esperança no início de qualquer cena com Forlorne como adversária, e um personagem a até alcance Longe pode gastar dessa reserva como se fosse a própria. Se o aliado cair inconsciente ou morrer, a reserva acaba."},{"id":"chave1","ordem":3,"nome":"Chave para a Vitória 1","efeito":"Um item de benefício defensivo, e onde ele está. Quando Forlorne aparece, quem segura ao menos um desses itens ganha 1d4 de Esperança."},{"id":"chave2","ordem":4,"nome":"Chave para a Vitória 2","efeito":"Uma arma capaz de ferir Forlorne. Quem a empunha ganha +1 de Proficiência nos ataques contra ela."},{"id":"lugarDoDesfecho","ordem":5,"nome":"Lugar do Desfecho","efeito":"Onde o grupo provavelmente vai enfrentá-la. Se chegarem lá com o segredo da 1ª, o aliado da 2ª e os itens da 3ª e da 4ª, Forlorne aparece sozinha — e duas das características passivas dela, Alimentar-se do Medo e Terrificante, não funcionam naquele lugar."}],"linhas":[{"d6":1,"lugarDoSegredo":{"texto":"Nightshade"},"aliadoPoderoso":{"texto":"Tiltuk (elu/delu), uma dríade jovem do Cemitério das Dríades, jurada a conter os weredraques que tomaram a terra natal dela."},"chave1":{"texto":"Um Planador preso na Torre Wyrmbolt, em Elevarne.","item":"loot-27"},"chave2":{"texto":"Um Machado lendário consagrado fincado num tronco no Pântano de Froghaven.","item":"primaria-t4-machado-lendario-consagrado"},"lugarDoDesfecho":{"texto":"Nightshade"}},{"d6":2,"lugarDoSegredo":{"texto":"Elevarne"},"aliadoPoderoso":{"texto":"Ehud (ele/dele), cacique de um clã de ursos sapientes às margens do rio que corta o Bosque Starlance. Ele compra a clemência de Forlorne com tributo regular — e o preço ficou intolerável."},"chave1":{"texto":"Uma Armadura de Brasa tecida das cinzas de uma dríade anciã, no Cemitério das Dríades.","item":"armadura-t4-armadura-de-brasa"},"chave2":{"texto":"Um Cetro lendário deixado em Nightshade.","item":"primaria-t4-cetro-lendario"},"lugarDoDesfecho":{"texto":"Elevarne"}},{"d6":3,"lugarDoSegredo":{"texto":"Nwarlyth"},"aliadoPoderoso":{"texto":"B’rahl Zed (ele/dele), um ogro das cavernas amaldiçoado com a imortalidade que vagueia pela Whelvewood protegendo os ermos do avanço de Forlorne."},"chave1":{"texto":"Uma Relíquia da Iluminação num marco da Whelvewood.","item":"loot-46"},"chave2":{"texto":"A Espada longa de Lady Lavender, em Knightstead.","item":"campanha-reino-do-weredragao-lady-lavenders-longsword","nota":"Uma das duas Chaves que QUEBRAM MALDIÇÃO — e os dois itens já estão no catálogo."},"lugarDoDesfecho":{"texto":"Nwarlyth"}},{"d6":4,"lugarDoSegredo":{"texto":"Lago Stillwater"},"aliadoPoderoso":{"texto":"Vexxen (elu/delu), um demônio preso há muito num obelisco em Knightstead, com poder que não é deste mundo. Lady Lavender pode ser convencida a libertá-lu."},"chave1":{"texto":"Um Anel de determinação inquebrável enterrado nas ruínas da Abadia de Vexstone.","item":"loot-59"},"chave2":{"texto":"Uma Espada de Sarças do Cavaleiro Cervo, no Bosque Starlance.","item":"primaria-t3-cutelo-avancado","nota":"O livro manda usar as estatísticas do Cutelo Avançado: é reflavor, não item novo."},"lugarDoDesfecho":{"texto":"Lago Stillwater"}},{"d6":5,"lugarDoSegredo":{"texto":"Abadia de Vexstone"},"aliadoPoderoso":{"texto":"Cymor Bucklethorn (ele/dele), halfling mestre de espiões da Guilda dos Ladrões de Whelvia. Montou uma rede clandestina para financiar a rebelião e foi traído; como punição, Forlorne o petrificou e o pôs em exposição na Abadia de Vexstone."},"chave1":{"texto":"Um Companheiro de barro que fez casa nas cavernas sob a Abadia de Vexstone.","item":"loot-50"},"chave2":{"texto":"Um Bastão de Fogo escondido numa das pedras eretas do Lago Stillwater.","item":"primaria-t3-bastao-de-fogo"},"lugarDoDesfecho":{"texto":"Abadia de Vexstone"}},{"d6":6,"lugarDoSegredo":{"texto":"Witch’s End"},"aliadoPoderoso":{"texto":"Harrowyrr Lykona (ela/dela), irmã gêmea de Forlorne, perdida num incêndio aos onze anos. Assombra Witch’s End como um esqueleto carbonizado envolto numa mortalha de cinzas."},"chave1":{"texto":"O Zootrópio do Bacanal Radiante, escondido em Witch’s End.","item":"campanha-reino-do-weredragao-zoetrope-of-the-bright-bacchanal","nota":"A outra Chave que QUEBRA MALDIÇÃO."},"chave2":{"texto":"Um Revólver Magus contrabandeado para Nightshade por uma organização clandestina.","item":"primaria-t4-revolver-magus"},"lugarDoDesfecho":{"texto":"Witch’s End"}}]}}}],
  "jornada-ate-o-horizonte": [{"id":"onde-a-mesa-esta","nome":"Onde a mesa está","automacao":{"escopo":"mesa","escolhaDaMesa":{"fonte":"Daggerheart: Hope & Fear, \"Resting\", p.176 — tradução nossa.","chave":"lugar","rotulo":"Onde o grupo está","ajuda":"Toque no lugar. Tocar no marcado desmarca.","opcoes":[{"id":"ermo","nome":"No ermo","nomeLivro":"wilderness","texto":"Fora de um santuário. Aqui o grupo só pode fazer descanso CURTO, e cada um deles representa um dia inteiro parado no mesmo lugar.","escolhaSe":"Marque isto enquanto o grupo estiver atravessando hexágonos.","perguntas":[]},{"id":"santuario","nome":"Num santuário","nomeLivro":"sanctuary","texto":"Dentro do anel de árvores de um santeiro de Aurelia. Aqui o grupo pode fazer descanso LONGO, que representa vários dias se recuperando — e os sacerdotes são obrigados por juramento a acolher viajantes respeitosos.","escolhaSe":"Marque isto quando o grupo chegar a um santuário.","perguntas":[]}]}}},{"id":"descanso-no-ermo","nome":"Descanso no ermo, e só num santuário o descanso longo","automacao":{"escopo":"ficha","avisoDeDescanso":{"tipo":"longo","exigeAnotacao":{"chave":"lugar","valor":"santuario"},"texto":"Nesta campanha o descanso longo só acontece DENTRO de um santuário (Hope & Fear p.176), e o Mestre ainda não marcou que a mesa está num. No ermo, só cabe descanso curto — quem decide é a mesa."}}},{"id":"localizar-ecos-de-alma","nome":"Movimento de descanso: Localizar Ecos de Alma","automacao":{"escopo":"ficha","movimentoDeDescanso":{"id":"localizar-ecos-de-alma","tipos":["curto","longo"],"observacao":"Você comunga com o Cálice e os Ecos chamam as irmãs: o Mestre diz a direção (norte, sul, leste, oeste ou combinação) do santuário mais próximo com um Eco. ⚠ A critério dele, isso também avisa os Buscadores-na-Sombra por perto."}}},{"id":"ecos-de-alma-e-avanco","nome":"Os Ecos de Alma, e o avanço que vem deles","automacao":{"escopo":"mesa","ecosDeAlma":{"fonte":"Daggerheart: Hope & Fear (Darrington Press), Capítulo 4, \"Soul Echoes\" p.165, \"Placing Soul Echoes\" p.169 e \"Character Advancement\" p.177 — tradução nossa.","total":10,"comecaCom":1,"aRecolher":9,"chaveDoLugar":"eco:lugar:","chaveDoCalice":"eco:calice:","nota":"Escreva em qual santuário está cada Eco antes da primeira sessão e marque cada um quando ele entrar no Cálice de Luz."}}},{"id":"trilha-da-ruina","nome":"A Trilha da Ruína","automacao":{"escopo":"mesa","trilhaDaRuina":{"fonte":"Daggerheart: Hope & Fear (Darrington Press), apêndice, Folha da Trilha da Ruína (\"Doom Track\", p.186) e a regra do Capítulo 4, p.177 — tradução nossa: não existe edição da Jambô deste capítulo.","chavePrefixo":"ruina:","nota":"Ao fim de cada sessão, marque UMA caixa do patamar do grupo ou abaixo dele. Uma caixa aninhada só pode ser marcada depois da caixa sob a qual ela está.","patamares":[{"numero":1,"nome":"Arautos Sombrios","nomeIngles":"Dark Harbingers","regra":"Depois de marcar 5 caixas neste patamar: quando você ganhar Medo ao fim de um descanso longo, role duas vezes e fique com o resultado maior.","caixas":[{"id":"t1a","texto":"Bandidos e saqueadores atormentam os viajantes.","filhas":[{"id":"t1a1","texto":"Crescem as tensões por recursos disputados."},{"id":"t1a2","texto":"Um santuário misteriosamente vazio é descoberto."},{"id":"t1a3","texto":"Um santuário se fecha outra vez."}]},{"id":"t1b","texto":"Um assentamento novo é tomado pelo ermo em avanço.","filhas":[{"id":"t1b1","texto":"Feras terríveis quiméricas revelam sua presença."},{"id":"t1b2","texto":"Enxames de insetos crescidos demais escurecem o céu."},{"id":"t1b3","texto":"Magia selvagem estilhaça magia e esfarela pedra."},{"id":"t1b4","texto":"A terrana supercarrega a magia de um jeito perigoso e imprevisível."}]},{"id":"t1c","texto":"Um pomar manchado pela sombra vira cinza da noite para o dia.","filhas":[{"id":"t1c1","texto":"Pássaros ressecados e enegrecidos caem mortos do céu."},{"id":"t1c2","texto":"Ecos manchados-sombra de entes queridos perdidos aparecem."}]},{"id":"t1d","texto":"Viajantes trocam histórias de Buscadores-na-Sombra avistados.","filhas":[{"id":"t1d1","texto":"O grupo tem visões do retorno dos Amantes."},{"id":"t1d2","texto":"Um santeiro aureliano aparece quebrado e profanado."},{"id":"t1d3","texto":"O grupo acha sinais de um Buscador."},{"id":"t1d4","texto":"O grupo acha restos de um ritual do Culto."},{"id":"t1d5","texto":"Um espião cultista segue o grupo."},{"id":"t1d6","texto":"O Cálice atrai atenção — e suspeita."}]}]},{"numero":2,"nome":"Ameaças Crescentes","nomeIngles":"Rising Threats","regra":"Depois de marcar 5 caixas neste patamar: quando você gerar uma região e o d20 cair em 1, trate como se tivesse tirado 1 duas vezes seguidas.","caixas":[{"id":"t2a","texto":"Bandos errantes de soldados profissionais exigem tributo na ponta da espada.","filhas":[{"id":"t2a1","texto":"Um demagogo sobe ao poder com promessas de prosperidade."},{"id":"t2a2","texto":"Um nobre exige vassalagem dos vizinhos."},{"id":"t2a3","texto":"Uma figura de destaque da Ordem Aureliana persegue os infiéis."},{"id":"t2a4","texto":"Civis são convocados em preparação para a guerra."}]},{"id":"t2b","texto":"O clima caótico mata a colheita.","filhas":[{"id":"t2b1","texto":"Maremotos e tornados castigam Valloren."},{"id":"t2b2","texto":"Feras terríveis e plantas carnívoras ambulantes atacam."},{"id":"t2b3","texto":"Uma praga fúngica se espalha pela terra."},{"id":"t2b4","texto":"Os estoques de comida apodrecem pela peste."},{"id":"t2b5","texto":"O chão se rasga e libera um miasma tóxico."}]},{"id":"t2c","texto":"A mancha-sombra alaga um santuário e prende os moradores.","filhas":[{"id":"t2c1","texto":"A água de um reservatório vira piche."},{"id":"t2c2","texto":"Humanoides manchados pela tristeza emergem de assentamentos escondidos."}]},{"id":"t2d","texto":"Um Buscador cruza o caminho do grupo.","filhas":[{"id":"t2d1","texto":"Um repositório insubstituível do saber da Velha Valloren é destruído."},{"id":"t2d2","texto":"Vários sacerdotes aurelianos são mortos num ataque coordenado."},{"id":"t2d3","texto":"Um Buscador persegue o grupo e os obriga a fugir."},{"id":"t2d4","texto":"Um inimigo descobre a verdadeira natureza do Cálice."}]}]},{"numero":3,"nome":"Destruição Iminente","nomeIngles":"Imminent Destruction","regra":"Depois de marcar 5 caixas neste patamar, os adversários ganham esta característica — Coração Sombrio (Passiva): gaste um Medo para dar vantagem ao adversário na próxima jogada dele.","caixas":[{"id":"t3a","texto":"A guerra é declarada, e cada santuário é chamado a escolher um lado.","filhas":[{"id":"t3a1","texto":"Um santuário cai pela discórdia interna."},{"id":"t3a2","texto":"Uma força militar imensa varre o continente."},{"id":"t3a3","texto":"Um santuário é sitiado e cai pela força militar."}]},{"id":"t3b","texto":"Uma explosão de abundância verdejante torna regiões intransponíveis.","filhas":[{"id":"t3b1","texto":"Uma criatura ancestral desperta de milênios de sono sem sonhos."},{"id":"t3b2","texto":"A terrana solta leva as pessoas a uma fúria animalesca."},{"id":"t3b3","texto":"Conjurar passa a causar exaustão mágica."},{"id":"t3b4","texto":"Feras de lenda deixam suas tocas para aterrorizar a população."}]},{"id":"t3c","texto":"A cor escorre do mundo.","filhas":[{"id":"t3c1","texto":"Vítimas da Longa Tristeza rastejam para fora das sepulturas."},{"id":"t3c2","texto":"Campos, florestas, selvas e pântanos inteiros apodrecem."},{"id":"t3c3","texto":"A mancha-sombra sem freio provoca um desespero do qual não se escapa."}]},{"id":"t3d","texto":"Um Buscador encurrala o grupo e os obriga a lutar.","filhas":[{"id":"t3d1","texto":"Uma figura poderosa revela sua aliança com o Culto."},{"id":"t3d2","texto":"Um Buscador derrotado reaparece com habilidades ou aliados novos."},{"id":"t3d3","texto":"Um exército de cultistas varre Valloren abatendo santuários."}]},{"id":"t3e","texto":"O Cálice é perdido ou roubado.","filhas":[]}]},{"numero":4,"nome":"Cataclismo Final","nomeIngles":"Final Cataclysm","regra":"A cada caixa que você marcar neste patamar, você ganha uma quantidade de Medo igual ao número de caixas marcadas neste patamar.","caixas":[{"id":"t4a","texto":"Um grupo de Buscadores embosca o grupo.","filhas":[]},{"id":"t4b","texto":"Valloren é rasgada por um lamaçal intransponível de mancha-sombra.","filhas":[]},{"id":"t4c","texto":"Um tirano reivindica a coroa de Valloren.","filhas":[]},{"id":"t4d","texto":"Um assassino fere mortalmente um membro do grupo.","filhas":[]},{"id":"t4e","texto":"Em bolsões da realidade, o tempo se entorta e se dobra sobre si mesmo.","filhas":[]},{"id":"t4f","texto":"Uma onda de magia selvagem varre o continente e transforma tudo que toca em formas crescidas demais e estranhas.","filhas":[]},{"id":"t4g","texto":"Santuários inteiros são aterrorizados por agentes colossais da terra, enfurecidos com a exploração dela.","filhas":[]},{"id":"t4h","texto":"O céu fica negro para sempre, mergulhando Valloren numa meia-noite sem fim.","filhas":[]},{"id":"t4i","texto":"Um a um, os santuários afundam sob a superfície de um mar infinito de mancha-sombra.","filhas":[]},{"id":"t4j","texto":"O véu da morte é rasgado e despeja cadáveres cambaleantes e espíritos impuros no reino mortal.","filhas":[{"id":"t4j1","texto":"Os Amantes despertam e começam a tecer a Segunda Tristeza.","filhas":[{"id":"t4j1a","texto":"O Cálice é destruído."}]}]}]}]}}}],
};

